[Unit]
Description=KlinikBot web (gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
WorkingDirectory=/opt/quantum/clinic_assistant
EnvironmentFile=/opt/quantum/clinic_assistant/.env
ExecStart=/opt/quantum/clinic_assistant/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8060 --workers 3 --timeout 30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
