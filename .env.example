# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# LLM (Groq — pulsuz, console.groq.com/keys)
GROQ_API_KEY=
ASSISTANT_MODEL=llama-3.3-70b-versatile
ASSISTANT_MAX_TOKENS=1024

# Meta (WhatsApp Cloud API + Instagram Messaging)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0

# Telegram bildirişləri
TELEGRAM_BOT_TOKEN=
